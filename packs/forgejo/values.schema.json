{
  "$comment": "SPDX-FileCopyrightText: 2026 Norca contributors; SPDX-License-Identifier: MPL-2.0",
  "type": "object",
  "properties": {
    "job_name": {"type": "string", "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,57})?$"},
    "namespace": {"type": "string"},
    "region": {"type": "string"},
    "datacenters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "node_pool": {"type": "string"},
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attribute", "operator"],
        "properties": {
          "attribute": {"type": "string"},
          "operator": {"type": "string", "minLength": 1},
          "value": {"type": "string"}
        }
      }
    },
    "image": {"type": "string", "minLength": 1},
    "image_digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
    "uid": {"type": "integer", "minimum": 1},
    "gid": {"type": "integer", "minimum": 1},
    "resources": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 100},
        "memory": {"type": "integer", "minimum": 256}
      }
    },
    "host_volume": {"type": "string", "minLength": 1},
    "startup_timeout": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
    "healthy_deadline": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
    "domain": {"type": "string", "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"},
    "http_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "root_url": {"type": "string", "pattern": "^(https?://[^/?#]+(/[^?#]*)?/)?$"},
    "host_network": {"type": "string"},
    "app_name": {"type": "string", "minLength": 1},
    "disable_registration": {"type": "boolean"},
    "require_signin_view": {"type": "boolean"},
    "extra_env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^FORGEJO__[A-Za-z0-9_.-]+__[A-Z0-9_]+$",
        "not": {"pattern": "(SECRET|TOKEN|PASSWD|PASSWORD|KEY_ID|ACCESS_KEY|CERT_FILE|KEY_FILE)"}
      },
      "additionalProperties": {"type": "string"}
    },
    "https_enabled": {"type": "boolean"},
    "tls_secret_path": {"type": "string", "minLength": 1},
    "ssh_enabled": {"type": "boolean"},
    "ssh_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "keys_secret_path": {"type": "string", "minLength": 1},
    "admin_enabled": {"type": "boolean"},
    "admin_username": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,39}$", "not": {"enum": ["admin", "api", "assets", "explore", "user", "org"]}},
    "admin_email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
    "admin_secret_path": {"type": "string", "minLength": 1},
    "storage_enabled": {"type": "boolean"},
    "storage_service": {"type": "string"},
    "storage_endpoint": {"type": "string", "pattern": "^([a-zA-Z0-9.\\[\\]:-]+:[0-9]{1,5})?$"},
    "storage_use_ssl": {"type": "boolean"},
    "storage_bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
    "storage_region": {"type": "string", "minLength": 1},
    "storage_secret_path": {"type": "string", "minLength": 1},
    "metrics_enabled": {"type": "boolean"},
    "metrics_token_secret_path": {"type": "string"},
    "dump_enabled": {"type": "boolean"},
    "dump_cron": {"type": "string", "minLength": 9},
    "dump_bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
    "dump_prefix": {"type": "string", "pattern": "^([a-zA-Z0-9._-]+/)*$"},
    "dump_resources": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 100},
        "memory": {"type": "integer", "minimum": 128}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"storage_enabled": {"const": true}, "storage_endpoint": {"const": ""}}, "required": ["storage_enabled", "storage_endpoint"]},
      "then": {"properties": {"storage_service": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"dump_enabled": {"const": true}}, "required": ["dump_enabled"]},
      "then": {"properties": {"storage_enabled": {"const": true}}, "required": ["storage_enabled"]}
    }
  ]
}
