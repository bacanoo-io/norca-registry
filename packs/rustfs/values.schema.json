{
  "$comment": "SPDX-FileCopyrightText: 2026 Norca contributors; SPDX-License-Identifier: MPL-2.0",
  "type": "object",
  "properties": {
    "job_name": {"type": "string", "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,62})?$"},
    "namespace": {"type": "string"},
    "region": {"type": "string"},
    "datacenters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "node_pool": {"type": "string"},
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attribute", "operator"],
        "properties": {
          "attribute": {"type": "string"},
          "operator": {"type": "string", "minLength": 1},
          "value": {"type": "string"}
        }
      }
    },
    "mode": {"enum": ["single", "distributed"]},
    "nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9.:\\[\\]-]+$"}},
    "node_address_attribute": {"type": "string", "pattern": "^\\$\\{(attr|meta)\\.[^}]+\\}$"},
    "image": {"type": "string", "minLength": 1},
    "image_digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
    "user": {"type": "string", "pattern": "^([0-9]+(:[0-9]+)?|[a-z_][a-z0-9_-]*)?$"},
    "resources": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 100},
        "memory": {"type": "integer", "minimum": 256}
      }
    },
    "log_level": {"enum": ["error", "warn", "info", "debug", "trace"]},
    "extra_env": {
      "type": "object",
      "propertyNames": {"pattern": "^RUSTFS_[A-Z0-9_]+$", "not": {"enum": ["RUSTFS_ACCESS_KEY", "RUSTFS_SECRET_KEY", "RUSTFS_ACCESS_KEY_FILE", "RUSTFS_SECRET_KEY_FILE", "RUSTFS_ROOT_USER", "RUSTFS_ROOT_PASSWORD", "RUSTFS_VOLUMES", "RUSTFS_ADDRESS"]}},
      "additionalProperties": {"type": "string"}
    },
    "metrics_enabled": {"type": "boolean"},
    "traces_enabled": {"type": "boolean"},
    "otlp_endpoint": {"type": "string", "pattern": "^https?://[^/?#]+(/[^?#]*)?$"},
    "host_volume": {"type": "string", "minLength": 1},
    "s3_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "console_enabled": {"type": "boolean"},
    "console_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "host_network": {"type": "string"},
    "s3_region": {"type": "string", "minLength": 1},
    "secret_path": {"type": "string", "minLength": 1},
    "buckets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"}},
    "startup_timeout": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
    "healthy_deadline": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "distributed"}}, "required": ["mode"]},
      "then": {"properties": {"nodes": {"minItems": 2}}, "required": ["nodes"]}
    }
  ]
}
