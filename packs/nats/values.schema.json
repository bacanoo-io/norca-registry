{
  "$comment": "SPDX-FileCopyrightText: 2026 Norca contributors; SPDX-License-Identifier: MPL-2.0",
  "$defs": {
    "subject": {
      "$comment": "A NATS subject or subject pattern: tokens separated by dots, * for one token, > as the last token. No whitespace, quotes, backslashes or braces.",
      "type": "string",
      "pattern": "^(([^\\s.*>\"'\\\\{}]+|\\*)\\.)*([^\\s.*>\"'\\\\{}]+|\\*|>)$"
    },
    "subjects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/subject"}},
    "account": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}
  },
  "type": "object",
  "properties": {
    "auth_mode": {"enum": ["none", "token", "nkey", "config", "userpass"]},
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
          "account": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/account"}]},
          "publish_allow": {"$ref": "#/$defs/subjects"},
          "publish_deny": {"$ref": "#/$defs/subjects"},
          "subscribe_allow": {"$ref": "#/$defs/subjects"},
          "subscribe_deny": {"$ref": "#/$defs/subjects"},
          "allow_responses": {"type": "boolean"}
        }
      }
    },
    "users_secret_prefix": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*$"},
    "users_default_account": {"$ref": "#/$defs/account"},
    "system_account": {"$ref": "#/$defs/account"},
    "bridge_nkey": {"type": "string", "pattern": "^(U[A-Z2-7]{55})?$"},
    "bridge_subject_prefix": {"type": "string", "pattern": "^[^\\s.*>\"'\\\\{}]+(\\.[^\\s.*>\"'\\\\{}]+)*$"}
  },
  "allOf": [
    {
      "if": {"properties": {"auth_mode": {"const": "userpass"}, "bridge_enabled": {"const": true}}, "required": ["auth_mode", "bridge_enabled"]},
      "then": {"properties": {"bridge_nkey": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"auth_mode": {"const": "userpass"}, "bridge_enabled": {"const": false}}, "required": ["auth_mode", "bridge_enabled"]},
      "then": {"properties": {"users": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"auth_mode": {"not": {"const": "userpass"}}}, "required": ["auth_mode"]},
      "then": {"properties": {"users": {"maxItems": 0}}}
    }
  ]
}
