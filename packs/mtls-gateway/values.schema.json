{
  "$comment": "SPDX-FileCopyrightText: 2026 Norca contributors; SPDX-License-Identifier: MPL-2.0",
  "type": "object",
  "properties": {
    "job_name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$"},
    "region": {"type": "string"},
    "datacenters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "node_pool": {"type": "string"},
    "job_type": {"enum": ["system", "service"]},
    "count": {"type": "integer", "minimum": 1},
    "distinct_hosts": {"type": "boolean"},
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attribute", "operator"],
        "properties": {
          "attribute": {"type": "string"},
          "operator": {"type": "string", "minLength": 1},
          "value": {"type": "string"}
        }
      }
    },
    "update_max_parallel": {"type": "integer", "minimum": 1},
    "service_name": {"type": "string", "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"},
    "service_tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "host_network": {"type": "string"},
    "network_mode": {"enum": ["bridge", "host"]},
    "envoy_task_enabled": {"type": "boolean"},
    "envoy_driver": {"enum": ["docker", "podman", "exec", "raw_exec"]},
    "envoy_image": {"type": "string"},
    "envoy_binary": {"type": "string"},
    "envoy_log_level": {"enum": ["", "trace", "debug", "info", "warning", "warn", "error", "critical", "off"]},
    "metrics_enabled": {"type": "boolean"},
    "metrics_port": {"type": "integer", "minimum": 0, "maximum": 65535},
    "envoy_resources": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 20},
        "memory": {"type": "integer", "minimum": 32}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"metrics_enabled": {"const": true}}, "required": ["metrics_enabled"]},
      "then": {"properties": {"envoy_task_enabled": {"const": true}}, "required": ["envoy_task_enabled"]}
    },
    {
      "if": {
        "properties": {"envoy_task_enabled": {"const": true}, "envoy_driver": {"enum": ["exec", "raw_exec"]}},
        "required": ["envoy_task_enabled", "envoy_driver"]
      },
      "then": {"properties": {"envoy_binary": {"minLength": 1}}}
    },
    {
      "if": {
        "properties": {"envoy_task_enabled": {"const": true}, "envoy_driver": {"const": "raw_exec"}},
        "required": ["envoy_task_enabled", "envoy_driver"]
      },
      "then": {"properties": {"network_mode": {"const": "host"}}, "required": ["network_mode"]}
    }
  ]
}
