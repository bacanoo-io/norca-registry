{
  "$comment": "SPDX-FileCopyrightText: 2026 Norca contributors; SPDX-License-Identifier: MPL-2.0",
  "$defs": {
    "service": {"type": "string", "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535}
  },
  "type": "object",
  "properties": {
    "job_name": {"type": "string", "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,52})?$"},
    "namespace": {"type": "string"},
    "region": {"type": "string"},
    "datacenters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "node_pool": {"type": "string"},
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attribute", "operator"],
        "properties": {
          "attribute": {"type": "string"},
          "operator": {"type": "string", "minLength": 1},
          "value": {"type": "string"}
        }
      }
    },
    "image": {"type": "string", "minLength": 1},
    "image_digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
    "resources": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 50},
        "memory": {"type": "integer", "minimum": 128}
      }
    },
    "collection_interval": {"type": "string", "pattern": "^[0-9]+(s|m)$"},
    "log_level": {"enum": ["debug", "info", "warn", "error"]},
    "otlp_enabled": {"type": "boolean"},
    "otlp_grpc_port": {"$ref": "#/$defs/port"},
    "otlp_http_port": {"$ref": "#/$defs/port"},
    "host_network": {"type": "string"},
    "openobserve_service": {"$ref": "#/$defs/service"},
    "openobserve_endpoint": {"type": "string", "pattern": "^(https?://[^/?#]+)?$"},
    "openobserve_tls": {"enum": ["mtls", "secret", "system", "none"]},
    "openobserve_server_name": {"type": "string", "pattern": "^([a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"},
    "openobserve_ca_secret_path": {"type": "string"},
    "openobserve_organization": {"type": "string", "pattern": "^([A-Za-z0-9_-]{1,64})?$"},
    "ingest_secret_path": {"type": "string", "minLength": 1},
    "hostmetrics_enabled": {"type": "boolean"},
    "host_root_volume": {"type": "string"},
    "nomad_metrics_enabled": {"type": "boolean"},
    "nomad_address": {"type": "string", "pattern": "^https?://[^/?#]+$"},
    "nomad_ca_secret_path": {"type": "string"},
    "discovery_namespaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9-]{1,128}$"}},
    "nats_metrics_enabled": {"type": "boolean"},
    "nats_metrics_service": {"$ref": "#/$defs/service"},
    "forgejo_metrics_enabled": {"type": "boolean"},
    "forgejo_service": {"$ref": "#/$defs/service"},
    "forgejo_metrics_secret_path": {"type": "string", "minLength": 1},
    "forgejo_tls_server_name": {"type": "string", "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"},
    "mtls_gateway_metrics_enabled": {"type": "boolean"},
    "mtls_gateway_metrics_service": {"$ref": "#/$defs/service"},
    "consul_metrics_enabled": {"type": "boolean"},
    "consul_metrics_service": {"$ref": "#/$defs/service"},
    "consul_metrics_secret_path": {"type": "string", "minLength": 1},
    "postgres_metrics_enabled": {"type": "boolean"},
    "postgres_service": {"$ref": "#/$defs/service"},
    "postgres_user": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
    "postgres_secret_path": {"type": "string", "minLength": 1},
    "postgres_tls": {"enum": ["none", "require", "verify-ca"]},
    "self_metrics_enabled": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"openobserve_tls": {"const": "secret"}}, "required": ["openobserve_tls"]},
      "then": {"properties": {"openobserve_ca_secret_path": {"minLength": 1}}, "required": ["openobserve_ca_secret_path"]}
    }
  ]
}
